# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# ===========================================
# Agent Server Configuration (Phase 1)
# ===========================================
# Server-side API keys live here without the VITE_ prefix so they never
# leak into the client bundle. Read by apps/agent-server/ at startup via
# dotenv (loaded from this repo root regardless of the workspace cwd).

# OpenAI — Whisper transcription via the openai-whisper provider, and
# future TTS via the openai-tts provider.
OPENAI_API_KEY=

# Video generation providers (used by generate_broll in later milestones)
# FAL_KEY=
# KIE_API_KEY=

# Voice synthesis (used by generate_voiceover in later milestones)
# ELEVENLABS_API_KEY=

# Optional: override the agent-server WebSocket port (default 5174)
# FREECUT_AGENT_PORT=5174
